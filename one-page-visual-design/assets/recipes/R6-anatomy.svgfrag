<!-- recipe R6-anatomy: anatomy with callouts around a hero. Inner markup for the template's stage <svg viewBox="0 0 392 215"> (A3 mm). Sample words are placeholders. See references/layout-recipes.md -->
<rect data-anchor x="128" y="30" width="136" height="170" rx="4" fill="var(--panel)" stroke="var(--line)" stroke-width=".4"/>
<!-- replace the rect above with: <image href="assets/hero.png" x="128" y="30" width="136" height="170" preserveAspectRatio="xMidYMid meet"/> and keep an invisible [data-anchor] rect for the leaders to end in -->
<text class="t3" x="196" y="115" text-anchor="middle">hero illustration</text><text class="t3" x="196" y="120" text-anchor="middle">(product, exploded or cut-away)</text>
<g class="node c1" data-node transform="translate(0 40)"><rect width="112" height="28" rx="2.4"/><text class="t2" x="14" y="11">Airframe</text><text class="t3" x="14" y="19">machined, 3 parts</text><text class="t3" x="14" y="25" style="font-weight:700">MAKE</text><circle cx="6" cy="14" r="3.4" fill="var(--paper)" stroke="var(--cat)" stroke-width=".4"/><text class="t3" x="6" y="15.2" text-anchor="middle" style="font-weight:700;fill:var(--ink)">1</text></g>
<path class="edge" data-edge style="marker-end:none;stroke-width:.35px" d="M112 54 H120 L150 64"/><circle cx="150" cy="64" r="1.3" fill="var(--ink-2)"/>
<g class="node c2" data-node transform="translate(0 96)"><rect width="112" height="28" rx="2.4"/><text class="t2" x="14" y="11">Motors</text><text class="t3" x="14" y="19">4x, imported</text><text class="t3" x="14" y="25" style="font-weight:700">BUY</text><circle cx="6" cy="14" r="3.4" fill="var(--paper)" stroke="var(--cat)" stroke-width=".4"/><text class="t3" x="6" y="15.2" text-anchor="middle" style="font-weight:700;fill:var(--ink)">2</text></g>
<path class="edge" data-edge style="marker-end:none;stroke-width:.35px" d="M112 110 H120 L160 112"/><circle cx="160" cy="112" r="1.3" fill="var(--ink-2)"/>
<g class="node c2" data-node transform="translate(0 152)"><rect width="112" height="28" rx="2.4"/><text class="t2" x="14" y="11">Flight computer</text><text class="t3" x="14" y="19">1x, imported</text><text class="t3" x="14" y="25" style="font-weight:700">BUY</text><circle cx="6" cy="14" r="3.4" fill="var(--paper)" stroke="var(--cat)" stroke-width=".4"/><text class="t3" x="6" y="15.2" text-anchor="middle" style="font-weight:700;fill:var(--ink)">3</text></g>
<path class="edge" data-edge style="marker-end:none;stroke-width:.35px" d="M112 166 H120 L190 168"/><circle cx="190" cy="168" r="1.3" fill="var(--ink-2)"/>
<g class="node c3" data-node transform="translate(280 40)"><rect width="112" height="28" rx="2.4"/><text class="t2" x="14" y="11">Battery</text><text class="t3" x="14" y="19">domestic cells</text><text class="t3" x="14" y="25" style="font-weight:700">BUY</text><circle cx="6" cy="14" r="3.4" fill="var(--paper)" stroke="var(--cat)" stroke-width=".4"/><text class="t3" x="6" y="15.2" text-anchor="middle" style="font-weight:700;fill:var(--ink)">4</text></g>
<path class="edge" data-edge style="marker-end:none;stroke-width:.35px" d="M280 54 H272 L240 60"/><circle cx="240" cy="60" r="1.3" fill="var(--ink-2)"/>
