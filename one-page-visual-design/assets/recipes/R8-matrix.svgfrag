<!-- recipe R8-matrix: matrix, top-down. Inner markup for the template's stage <svg viewBox="0 0 392 215"> (A3 mm). Sample words are placeholders. See references/layout-recipes.md -->
<defs><circle id="mk-full" r="4" fill="var(--c1)"/><g id="mk-part"><path d="M0 -4A4 4 0 0 0 0 4Z" fill="var(--c1)"/><circle r="4" fill="none" stroke="var(--c1)" stroke-width=".6"/></g><circle id="mk-none" r="4" fill="none" stroke="var(--line)" stroke-width=".5" stroke-dasharray="1 1"/></defs>
<text class="t3" x="102" y="10" text-anchor="middle" style="font-weight:700">MAKE</text>
<text class="t3" x="166" y="10" text-anchor="middle" style="font-weight:700">BUY DOMESTIC</text>
<text class="t3" x="230" y="10" text-anchor="middle" style="font-weight:700">BUY IMPORT</text>
<text class="t3" x="294" y="10" text-anchor="middle" style="font-weight:700">LEAD TIME</text>
<text class="t3" x="358" y="10" text-anchor="middle" style="font-weight:700">RISK</text>
<g transform="translate(0 18)"><rect width="392" height="24" rx="2" fill="var(--panel)"/><text class="t2" x="3" y="13.5">Frame</text><use href="#mk-full" x="102" y="12"/><use href="#mk-none" x="166" y="12"/><use href="#mk-none" x="230" y="12"/><text class="t2" x="294" y="13.4" text-anchor="middle">3 wk</text><text class="t2" x="358" y="13.4" text-anchor="middle">low</text><rect x="346" y="16.6" width="24" height="1.6" rx=".8" fill="var(--c3)"/></g>
<g transform="translate(0 44)"><rect width="392" height="24" rx="2" fill="var(--panel)"/><text class="t2" x="3" y="13.5">Motors</text><use href="#mk-none" x="102" y="12"/><use href="#mk-none" x="166" y="12"/><use href="#mk-full" x="230" y="12"/><text class="t2" x="294" y="13.4" text-anchor="middle">12 wk</text><text class="t2" x="358" y="13.4" text-anchor="middle">high</text><rect x="346" y="16.6" width="24" height="1.6" rx=".8" fill="var(--c2)"/></g>
<g transform="translate(0 70)"><rect width="392" height="24" rx="2" fill="var(--panel)"/><text class="t2" x="3" y="13.5">Flight computer</text><use href="#mk-none" x="102" y="12"/><use href="#mk-none" x="166" y="12"/><use href="#mk-full" x="230" y="12"/><text class="t2" x="294" y="13.4" text-anchor="middle">20 wk</text><text class="t2" x="358" y="13.4" text-anchor="middle">high</text><rect x="346" y="16.6" width="24" height="1.6" rx=".8" fill="var(--c2)"/></g>
<g transform="translate(0 96)"><rect width="392" height="24" rx="2" fill="var(--panel)"/><text class="t2" x="3" y="13.5">Battery</text><use href="#mk-none" x="102" y="12"/><use href="#mk-part" x="166" y="12"/><use href="#mk-part" x="230" y="12"/><text class="t2" x="294" y="13.4" text-anchor="middle">8 wk</text><text class="t2" x="358" y="13.4" text-anchor="middle">med</text><rect x="346" y="16.6" width="24" height="1.6" rx=".8" fill="var(--c5)"/></g>
<g transform="translate(0 122)"><rect width="392" height="24" rx="2" fill="var(--panel)"/><text class="t2" x="3" y="13.5">Payload</text><use href="#mk-full" x="102" y="12"/><use href="#mk-none" x="166" y="12"/><use href="#mk-none" x="230" y="12"/><text class="t2" x="294" y="13.4" text-anchor="middle">2 wk</text><text class="t2" x="358" y="13.4" text-anchor="middle">low</text><rect x="346" y="16.6" width="24" height="1.6" rx=".8" fill="var(--c3)"/></g>
<g class="legend" transform="translate(0 164)"><text class="t3" style="font-weight:700">LEGEND</text><use href="#mk-full" transform="translate(28 -1.2) scale(.6)"/><text class="t3" x="32" y="0">full source</text><use href="#mk-part" transform="translate(62 -1.2) scale(.6)"/><text class="t3" x="66" y="0">partial</text><use href="#mk-none" transform="translate(92 -1.2) scale(.6)"/><text class="t3" x="96" y="0">not used (a gap if nothing else covers the row)</text></g>
